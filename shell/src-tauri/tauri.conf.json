{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "工作秘书",
  "version": "0.3.0",
  "identifier": "com.workhelper.desktop",
  "build": {
    "frontendDist": "../../src/ui/static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "工作秘书",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/node": "node",
      "resources/src": "src"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
