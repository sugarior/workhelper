{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "工作秘书",
  "version": "0.2.0",
  "identifier": "com.workhelper.desktop",  "build": {
    "frontendDist": "../../src/ui/static",
    "beforeBuildCommand": "node ../../scripts/prepare-resources.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "工作秘书",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "resources/node": "node",
      "resources/src": "src"
    }
  }
}
