# 统一行尾，避免在 Windows 上产生 LF/CRLF 噪音 diff
* text=auto eol=lf

# 二进制资源不参与行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.db   binary
*.exe  binary

# 文档与源码显式声明文本
*.md   text
*.ts   text
*.js   text
*.json text
*.sql  text
*.yml  text
*.yaml text
*.html text
*.css  text
